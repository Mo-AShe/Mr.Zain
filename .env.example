# Server & Environment
NODE_ENV=development
PORT=3000

# Neon PostgreSQL (SSL & Pooling required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Session & JWT Authentication
SESSION_SECRET="replace_with_a_strong_random_session_secret_at_least_32_chars"
JWT_SECRET="replace_with_a_strong_random_secret_at_least_32_chars"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Media Upload Limits (bytes)
MAX_UPLOAD_BYTES=5242880

# GEMINI_API_KEY (optional)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Initial Admin Bootstrap (CLI-only, never expose to frontend or commit real secrets)
# ADMIN_EMAIL="admin@mrzain.example"
# ADMIN_PASSWORD="ReplaceWithStrong!12CharPassword"
# ADMIN_FULL_NAME="MR. ZAIN Administrator"
